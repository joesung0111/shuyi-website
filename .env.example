# Analytics: 1–3650 days; default 30.
ANALYTICS_RETENTION_DAYS=30

# Optional override, comma or newline separated. The application bundles the
# current Cloudflare edge CIDRs and trusts CF visitor-IP headers only when the
# verified edge source matches one of them (directly or through Railway X-Real-IP). Set empty to trust no Cloudflare ranges.
# CLOUDFLARE_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22,...

# Production deployments should keep the database on a persistent volume.
# DATABASE_PATH=/data/shuyi.sqlite

# Required; set a unique strong password through Railway Variables.
# SHUYI_ADMIN_PASSWORD=

# Optional exact Railway HTTP ingress peer allowlist (comma separated).
# Default: observed peers 100.64.0.1 through 100.64.0.21, only on Railway.
# Unknown peers fail closed; inspect /api/analytics/diagnostics as an admin.
# RAILWAY_PROXY_PEERS=
