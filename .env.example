# Analytics: 1–3650 days; default 30.
ANALYTICS_RETENTION_DAYS=30

# Optional override, comma or newline separated. The application bundles the
# current Cloudflare edge CIDRs and trusts CF visitor-IP headers only when the
# direct TCP peer matches one of them. Set empty to trust no Cloudflare ranges.
# CLOUDFLARE_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22,...

# Production deployments should keep the database on a persistent volume.
# DATABASE_PATH=/data/shuyi.sqlite
